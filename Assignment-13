
class Book {

  // Book properties
  String title;
  String author;

  // Constructor
  Book(this.title, this.author);

  // Display book information
  void displayInfo() {
    print("Book Title: $title");
    print("Author Name: $author");
  }
}

void main() {

  // Create a book object
  Book myBook = Book(
    "Learning Dart",
    "John Smith"
  );

  print("===== Book Information =====");

  myBook.displayInfo();

  print("============================");
}
