
void main() {

  // Create a list of students
  List<String> students = [
    "Ali",
    "Sara",
    "Reza",
    "Mina",
    "Amir"
  ];

  print("===== Student List =====");

  // Display all students
  for (int i = 0; i < students.length; i++) {
    print("${i + 1}. ${students[i]}");
  }

  print("========================");
  print("Total Students: ${students.length}");
}
